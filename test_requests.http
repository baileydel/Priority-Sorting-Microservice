#This test should successfully return items sorted by tasksCompleted ascending.
POST http://localhost:3000/sortObjects HTTP/1.1
content-type: application/json

{
    "items": [{
        "id": 1,
        "name": "Lucas",
        "role": "Frontend",
        "email": "lucas@example.com",
        "joinedDate": "2026-09-28",
        "tasksCompleted": 7,
        "active": true
    },
    {
        "id": 2,
        "name": "Bailey",
        "role": "Backend",
        "email": "bailey@example.com",
        "joinedDate": "2026-09-24",
        "tasksCompleted": 12,
        "active": true
    },
    {
        "id": 3,
        "name": "Corson",
        "role": "Testing",
        "email": "corson@example.com",
        "joinedDate": "2026-10-05",
        "tasksCompleted": 9,
        "active": false
    }],
    "sortBy": "tasksCompleted",
    "order": "asc"
}

