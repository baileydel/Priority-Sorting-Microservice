###

#This test should return error: priority field must contain int or dec

POST http://localhost:3000/priority HTTP/1.1
content-type: application/json

{   
    "priorityItems": [ 
    {
        "item": {
            "id": 1,
            "name": "Test",
            "boolean": true
        },
        "priority": "asdf"

    },
    {
        "item": {
            "id": 2,
            "name": "Another Test",
            "boolean": true
        },
        "priority": "o"
    },
    {
        "item": {
            "id": 3,
            "name": "Again",
            "boolean": false
        },
        "priority": ""
    },
    {
        "item": {
            "id": 4,
            "name": "One More",
            "boolean": true
        },
        "priority": "3"
    }],
    "order": "desc"
    
}

