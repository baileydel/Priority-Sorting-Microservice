###
#This test should successfully return items sorted by priority ascending.
POST http://localhost:3000/priority HTTP/1.1
content-type: application/json

{   
    "priorityItems": [ 
    {
        "item": {
            "id": 1,
            "name": "Test",
            "boolean": true
        },
        "priority": 2

    },
    {
        "item": {
            "id": 2,
            "name": "Another Test",
            "boolean": true
        },
        "priority": 1
    },
    {
        "item": {
            "id": 3,
            "name": "Again",
            "boolean": false
        },
        "priority": 4
    },
    {
        "item": {
            "id": 4,
            "name": "One More",
            "boolean": true
        },
        "priority": 3
    }],
    "order": "asc"
    
}

